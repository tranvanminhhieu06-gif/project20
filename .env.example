# Sao chép thành .env (hoặc khai báo biến môi trường trên Render/VPS)
PORT=3000
NODE_ENV=production
SITE_URL=https://themeal.vn

# Trang quản trị /admin (bắt buộc đặt để bật)
ADMIN_USER=admin
ADMIN_PASS=doi-mat-khau-manh

# Chuyển khoản VietQR (để trống => ẩn mã QR)
BANK_BIN=
BANK_NAME=
BANK_ACCOUNT=
BANK_HOLDER=

# Phí ship (VND). Để trống => "xác nhận khi gọi chốt đơn"
SHIPPING_FEE=
FREESHIP_FROM=

# Thông báo đơn mới qua Telegram (tuỳ chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Bản tĩnh (GitHub Pages): URL nhận đơn & form liên hệ, VD Google Apps Script
# (xem scripts/google-apps-script.gs). Để trống => khách được hướng dẫn gọi/nhắn Zalo.
ORDER_ENDPOINT=

# Thông tin bổ sung (để trống => ẩn ở bản thật)
TAX_CODE=
WORKING_HOURS=
ZALO_URL=https://zalo.me/0338725103
